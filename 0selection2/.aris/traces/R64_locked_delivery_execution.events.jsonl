{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/usr/bin/bash -lc \"source /public/home/shiys/miniconda3/etc/profile.d/conda.sh && conda activate easynco && python -B - <<'PY'\nimport csv,io,json\nfrom pathlib import Path\nfrom datetime import datetime\nroot=Path('code/V4/runs/R64_pcgrad_full18').resolve()\na=json.loads((root/'analysis.json').read_text()); lock=json.loads((root/'final_test_lock.json').read_text()); test=json.loads((root/'test_results.json').read_text())\nmetrics=('top1','top2','top3','ce','mean_cost','vs_sbs_pct','actual_regret_pct')\nnames={'A':'A_mean_gradient_seed2','B':'B_pcgrad_seed2'}\ndef csv_text(rows):\n    s=io.StringIO(newline=''); w=csv.DictWriter(s,fieldnames=list(rows[0]),lineterminator='\\\\n');w.writeheader();w.writerows(rows);return s.getvalue()\ndef scopes(v):\n    yield 'aggregate','ALL',v['macro'],'macro_'\n    for k,x in v['families'].items(): yield 'family',k,x,'macro_'\n    for k,x in v['per_problem'].items(): yield 'task',k,x,''\ndatasets={f'R64{k}':v for k,v in a['selected'].items()}\nepochs={f'R64{k}':v['epoch'] for k,v in lock['models'].items()}\nfor name,v in a['reused_official_test_references'].items(): datasets[name]={'val':v['validation'],'test':v['test']};epochs[name]=v['selected_epoch']\nrows=[]\nfor model,splits in datasets.items():\n    for split,v in splits.items():\n        for kind,scope,d,prefix in scopes(v):\n            count=v.get('native_correct','') if scope=='ALL' else d.get('native_correct','')\n            total=v.get('native_total','') if scope=='ALL' else d.get('n','')\n            rows.append(dict(model=model,checkpoint_epoch=epochs[model],split=split,scope_kind=kind,scope=scope,native_correct=count,native_total=total,**{m:d[prefix+m] for m in metrics}))\ndeltas=[]\ncomparisons=[('R64B','R64A',('train','val','test')),('R64A','R45A',('val','test')),('R64B','R45A',('val','test')),('R64A','R60B',('val','test')),('R64B','R60B',('val','test'))]\nfor left,right,splits in comparisons:\n    for split in splits:\n        lv,rv=datasets[left][split],datasets[right][split]\n        for scope in ('ALL','TSP','CVRP','ATSP','MVRP'):\n            lm=lv['macro'] if scope=='ALL' else lv['families'][scope]; rm=rv['macro'] if scope=='ALL' else rv['families'][scope]\n            d={('delta_'+m+'_pp' if m in ('top1','top2','top3') else 'delta_'+m): (lm['macro_'+m]-rm['macro_'+m])*(100 if m in ('top1','top2','top3') else 1) for m in metrics}\n            deltas.append(dict(comparison=left+' minus '+right,split=split,scope=scope,**d))\nlast5=[];compute={};facts=dict(lock=lock,decision=a['decision'],test_wall_seconds=test['wall_seconds'],macro={m:{s:v['macro'] for s,v in splits.items()} for m,splits in datasets.items()},task_top1={m:{s:{p:d['top1'] for p,d in v['per_problem'].items()} for s,v in splits.items()} for m,splits in datasets.items()},family_top1={m:{s:{f:d['macro_top1'] for f,d in v['families'].items()} for s,v in splits.items()} for m,splits in datasets.items()},last5={})\nfor arm,name in names.items():\n    result=json.loads((root/name/'result.json').read_text());history=json.loads((root/name/'history.json').read_text())\n    for row in history[-5:]: last5.append(dict(arm=arm,epoch=row['epoch'],native_correct=row['val']['native_correct'],native_total=row['val']['native_total'],**{m:row['val']['macro']['macro_'+m] for m in metrics}))\n    facts['last5'][arm]={m:sum(row['val']['macro']['macro_'+m] for row in history[-5:])/5 for m in metrics}\n    n=sum(row['optimization']['updates'] for row in history)\n    opt={m:sum(row['optimization'][m]*row['optimization']['updates'] for row in history)/n for m in ('grad_norm','clip_coefficient','projection_mean_change_norm','projection_relative_mean_change')}\n    opt.update(conflict_pairs=sum(row['optimization']['conflict_pairs'] for row in history),comparable_pairs=sum(row['optimization']['comparable_pairs'] for row in history),training_epoch_seconds=sum(row['optimization']['seconds'] for row in history),peak_memory_gib=max(row['optimization']['peak_memory_gib'] for row in history))\n    opt['conflict_frequency']=opt['conflict_pairs']/opt['comparable_pairs']\n    timing=json.loads((root/name/'inference_timing.json').read_text());sing=[r for d in timing['per_problem'].values() for r in d['singleton']];bat=[r for d in timing['per_problem'].values() for r in d['batched']]\n    inference=dict(scope=timing['scope'],excludes=timing['excludes'],selected_validation_seconds=timing['seconds'],singleton_calls=len(sing),singleton_mean_ms=1000*sum(r['seconds'] for r in sing)/len(sing),batched_calls=len(bat),batched_queries=sum(r['queries'] for r in bat),batched_seconds=sum(r['seconds'] for r in bat),batched_queries_per_second=sum(r['queries'] for r in bat)/sum(r['seconds'] for r in bat))\n    compute[arm]=dict(epochs=result['epochs_completed'],successful_updates=result['successful_updates'],presentations=result['presentations'],amp_retries=result['amp_retries'],arm_wall_seconds=result['wall_seconds'],wall_attempts=json.loads((root/name/'wall_time.json').read_text()),optimization=opt,inference=inference,normal_timing_validation_correct=result['best']['selected_validation']['native_correct'],normal_timing_validation_count_delta=result['best']['selected_validation_count_delta'],original_selection_validation_correct=result['best']['val']['native_correct'],final_epoch=result['final']['epoch'],final_validation_correct=result['final']['val']['native_correct'])\nfiles={'comparison.csv':csv_text(rows),'comparison_deltas.csv':csv_text(deltas),'last5_validation.csv':csv_text(last5),'compute_summary.json':compute}\nassert all(not (root/p).exists() for p in files)\nfacts.update(compute=compute,comparison_rows=len(rows),delta_rows=len(deltas),analysis_completed_at=datetime.fromtimestamp((root/'analysis.json').stat().st_mtime).astimezone().isoformat(),generated_at=datetime.now().astimezone().isoformat(),reference_provenance=json.loads((root/'reference_provenance.json').read_text()))\npr