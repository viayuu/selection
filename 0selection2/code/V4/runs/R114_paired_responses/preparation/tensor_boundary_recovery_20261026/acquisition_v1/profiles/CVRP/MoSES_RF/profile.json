{
  "adapter_source": "class AliasSafeMosesBackend(RouteFinderBackend):\n    def profile(self):\n        result = super().profile()\n        result[\"checkpoint_loading\"] = \"Strict full-state loading; duplicate names are restored only from another checkpoint key referencing the identical registered parameter/buffer object. No random or substituted weights.\"\n        return result\n\n    def run(self, items):\n        scale = sample_scale(self.problem, items[0])\n        bucket = 50 if scale <= 75 else 100\n        runner = self.pool.get(self.key, bucket)\n        if bucket not in self.validated_buckets:\n            checkpoint = torch.load(self.checkpoints[str(bucket)], map_location=\"cpu\", weights_only=False)\n            weights = {name[len(\"policy.\"):]: value for name, value in checkpoint[\"state_dict\"].items()\n                       if name.startswith(\"policy.\")}\n            if not weights:\n                raise ValueError(\"The original checkpoint has no policy weights\")\n            restored = load_alias_complete_state(runner.policy, weights)\n            if \"B\" in self.problem:\n                from train_100k_routefinder import install_signed_demand_adapter\n                install_signed_demand_adapter(runner.env)\n            self.validated_buckets.add(bucket)\n            print(f\"ALIAS_CHECKPOINT_LOAD {self.problem}/{self.method} bucket={bucket} restored_duplicate_names={restored}\", flush=True)\n        return super().run(items)\n",
