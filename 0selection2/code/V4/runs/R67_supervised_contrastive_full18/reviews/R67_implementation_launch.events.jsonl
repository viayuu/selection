             print(f'[R65{arm}] epoch={epoch+1} update={step+1}/240 total={successful} '\n                          f'loss={totals[\"loss\"]/totals[\"samples\"]:.5f} lr={lr:.9g} retries={retries}', flush=True)\n                if wandb_run is not None and (successful == 1 or successful % 60 == 0):\n                    wandb_run.log({key: metrics[key] for key in ('successful_update', 'epoch', 'loss', 'ce',\n                        'kl', 'lr', 'optimizer_base_lr', 'grad_norm', 'clip_coefficient', 'retries', 'scale',\n                        'peak_memory_gib', 'queries_per_second')})\n            if (totals['samples'] != PRESENTATIONS_PER_EPOCH or totals['updates'] != 240\n                    or len(task_stats) != 18 or successful != (epoch+1)*240\n                    or any(item['rows'] != 10000 or item['batches'] != 40 for item in task_stats.values())):\n                raise ValueError('R65 must retain every original TRAIN row once per epoch')\n            optimization = {key: totals[key]/totals['samples'] for key in ('loss', 'ce', 'kl')}\n            optimization.update({key: totals[key]/totals['updates'] for key in ('grad_norm', 'clip_coefficient')})\n            optimization.update(lr=lr, lr_first=lr_trace[epoch*240], consistency_weight=.35*progress,\n                samples=totals['samples'], updates=totals['updates'], amp_retries=int(totals['retries']),\n                seconds=epoch_prior_seconds+time.monotonic()-epoch_started,\n                peak_memory_gib=max(epoch_peak_gib, torch.cuda.max_memory_allocated(args.device)/2**30))\n            per_task = {}\n            for task, item in task_stats.items():\n                per_task[task] = dict(item)\n                for key in ('loss', 'ce', 'kl'):\n                    per_task[task][key] /= item['rows']\n                per_task[task]['full_grad_norm'] /= item['batches']\n            evaluation_mode(model, optimizer, arm)\n            validation = evaluate(model, loaders['val'], raw['val'], 128,\n                                  directory/f'val_predictions/epoch{epoch+1:03d}')\n            if validation['native_total'] != 18000 or any(r['n'] != 1000 for r in validation['per_problem'].values()):\n                raise ValueError('Validation must contain all18000 original queries')\n            training = (evaluate(model, loaders['train'], raw['train'], 128,\n                                 directory/f'train_predictions/epoch{epoch+1:03d}')\n                        if (epoch+1) % 5 == 0 or epoch+1 == 40 else None)\n            row = dict(epoch=epoch+1, successful_updates=successful, presentations=presentations,\n                updates_by_problem=dict(counts), optimization=optimization, task_optimization=per_task,\n                train=training, val=validation, parameter_mode='averaged x' if arm == 'B' else 'ordinary')\n            history.append(row)\n            if prefer_checkpoint(validation, None if best is None else best['val']):\n                best, best_model = row, {key: value.detach().cpu().clone() for key, value in model.state_dict().items()}\n            totals, task_stats = Counter(), {}\n            save_state(epoch+1, 0, 0., 0.)\n            append_jsonl(args.root/'curves'/(arm+'_metrics.jsonl'), row)\n            print_eval(f'R65{arm} val epoch{epoch+1}', validation['per_problem'], validation['macro'])\n            if wandb_run is not None:\n                wb = dict(epoch=epoch+1, successful_update=successful,\n                          **{'optimization/'+key: value for key, value in optimization.items()})\n                for split, value in (('train_eval', training), ('val', validation)):\n                    if value is not None:\n                        wb.update({split+'/'+key: entry for key, entry in value['macro'].items()})\n                        wb[split+'/native_correct'] = value['native_correct']\n                        for task, result in value['per_problem'].items():\n                            wb.update({f'{split}/{task}/{key}': result[key] for key in\n                                       ('top1', 'top2', 'top3', 'ce', 'mean_cost', 'actual_regret_pct')})\n                wandb_run.log(wb)\n        if best is None or len(history) != 40 or successful != 9600 or presentations != 7200000:\n            raise ValueError('R65 requires the complete fixed40E/9600update/7.2M horizon')\n        # The last model/optimizer remains saved consistently at final x. Best x is evaluation only.\n        model.load_state_dict(best_model, strict=True)\n        model.eval()\n        selected_train = evaluate(model, loaders['train'], raw['train'], 128, directory/'train_predictions/best')\n        selected_val = evaluate(model, loaders['val'], raw['val'], 128, directory/'val_predictions/best')\n        best_eval = dict(best, train=selected_train, selected_validation=selected_val,\n            selected_validation_count_delta=selected_val['native_correct']-best['val']['native_correct'])\n        atomic_json(directory/'best_eval.json', best_eval)\n        atomic_json(directory/'result.json', dict(best=best_eval, final=history[-1], epochs_completed=40,\n            successful_updates=successful, presentations=presentations, updates_by_problem=dict(counts),\n            amp_retries=retries, actual_execution=executed_updates(directory),\n            best_checkpoint_sha256=file_hash(directory/'best.pt'), checkpoint_rule=protocol['checkpoint_rule'],\n            inference_rule=INFERENCE_RULE, lr_trace_sha256=state_hash(lr_trace), fixed_matched_horizon=True,\n            selection_uses_original_epoch_validation=True, selected_eval_does_not_reselect=True,\n            deployment_parameter_mode='averaged x' if arm == 'B' else 'ordinary',\n            stop_reason='fixed maximum40 epochs', test_read=False, test_authorized=False))\n    finally:\n        if wandb_run is not None:\n            wandb_run.finish()\n\n\ndef run(arm, args, data):\n    directory = args.root/RUN_NAMES[arm]\n    if (directory/'result.json').exists():\n        if not args.resume:\n            raise ValueError('Preserve completed R65 arms; --resume skips them')\n        return\n    (directory/'launches').mkdir(exist_ok=True)\n    stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')\n    launch = dict(id=stamp, arm=arm, status='started', started_unix=time.time(), host=socket.gethostname(),\n        pid=os.getpid(), gpu_uuid=os.environ.get('CUDA_VISIBLE_DEVICES'),\n        slurm_step=os.environ.get('SLURM_JOB_ID', '')+'.'+os.environ.get('SLURM_STEP_ID', ''),\n        tmux_session='r65_train', formal=True)\n    started, status = time.monotonic(), 'failed'\n    atomic_json(directory/'launches'/(stamp+'.json'), launch)\n    with (directory/'train.log').open('a') as stream, redirect_stdout(Tee(sys.stdout, stream)), redirect_stderr(Tee(sys.stderr, stream)):\n        try:\n            train(arm, args, directory, data, launch)\n            status = 'complete'\n        finally:\n            launch.update(status=status, wall_seconds=time.monotonic()-started, finished_unix=time.time())\n            atomic_json(directory/'launches'/(stamp+'.json'), launch)\n            attempts = [json.loads(path.read_text()) for path in sorted((directory/'launches').glob('*.json'))]\n            atomic_json(directory/'wall_time.json', attempts)\n            if status == 'complete':\n                result = json.loads((directory/'result.json').read_text())\n                result['wall_seconds'] = sum(row.get('wall_seconds', 0.) for row in attempts)\n                atomic_json(directory/'result.json', result)\n\n\ndef publish_validation_candidates(root):\n    records, lr_hashes = {}, []\n    for arm, name in RUN_NAMES.items():\n        directory = root/name\n        result = json.loads((directory/'result.json').read_text())\n        records[arm] = dict(path=str(directory/'best.pt'), sha256=result['best_checkpoint_sha256'],\n            epoch=result['best']['epoch'], native_correct=result['best']['val']['native_correct'],\n            native_total=18000, val=result['best']['val']['macro'], parameter_mode=result['deployment_parameter_mode'])\n        lr_hashes.append(result['lr_trace_sha256'])\n    if len(set(lr_hashes)) != 1:\n        raise ValueError('R65 arms must use the same effective LR sequence')\n    official = 'A' if records['A']['native_correct'] >= records['B']['native_correct'] else 'B'\n    atomic_json(root/'validation_candidates.json', dict(models=records, proposed_official_arm=official,\n        inference_rule=INFERENCE_RULE, parent_freeze_pending=True, test_authorized=False,\n        same_effective_lr_trace_sha256=lr_hashes[0]))\n\n\ndef final_test(args):\n    from .performance_targets import read_raw_costs\n    from .train import make_loader\n\n    protocol = json.loads((args.root/'protocol.json').read_text())\n    lock = json.loads((args.root/'final_test_lock.json').read_text())\n    candidates = json.loads((args.root/'validation_candidates.json').read_text())\n    if (lock.get('authorized') is not True or lock.get('inference_rule') != INFERENCE_RULE\n            or lock.get('official_arm') != candidates['proposed_official_arm']\n            or set(lock.get('models', {})) != {'A', 'B'}):\n        raise ValueError('TEST requires parent authorization of both frozen weights, rule and official arm')\n    if protocol['source_hashes'] != source_hashes():\n        raise ValueError('R65 frozen sources changed before authorized TEST')\n    for arm, record in lock['models'].items():\n        expected = candidates['models'][arm]\n        if any(record[key] != expected[key] for key in ('path', 'sha256', 'epoch', 'native_correct')):\n            raise ValueError('TEST cannot change a validation-selected R65 model')\n        if file_hash(Path(record['path'])) != record['sha256']:\n            raise ValueError('Frozen R65 checkpoint changed')\n    with (args.root/'final_test_started.json').open('x') as stream:\n        json.dump(dict(lock=lock, started_unix=time.time(), one_complete_original_test_per_frozen_model=True), stream, indent=2)\n    started, results = time.monotonic(), {}\n    raw = {task: read_raw_costs(task, 'test') for task in PROBLEMS}\n    loaders = {}\n    for task, record in raw.items():\n        manifest = protocol['data_manifest']['train'][task]\n        if len(record['winner']) != 1000 or any(record[key] != manifest[key] for key in ('pool', 'pool_ids')):\n            raise ValueError('Locked TEST retains all original rows and full legal pools')\n        loader = make_loader(task, 'test', 128, 0, shuffle=False, cache_device=args.device)\n        loader.drop_last = False\n        np.testing.assert_array_equal(loader.batch['ind'].cpu(), record['winner'])\n        np.testing.assert_array_equal(loader.batch['pool_ids'].cpu(), record['pool_ids'])\n        np.testing.assert_array_equal(loader.batch['costs'].cpu(), record['costs'].astype(np.float32))\n        loaders[task] = loader\n    for arm, record in lock['models'].items():\n        model, _ = initialize(protocol['geometry_stats'], args.device, seed=2)\n        checkpoint = torch.load(record['path'], map_location='cpu', weights_only=False)\n        if checkpoint['epoch']+1 != record['epoch'] or checkpoint['parameter_mode'] != candidates['models'][arm]['parameter_mode']:\n            raise ValueError('Frozen R65 epoch or deployment parameter mode mismatch')\n        model.load_state_dict(checkpoint['model'], strict=True)\n        model.eval()\n        results[arm] = evaluate(model, loaders, raw, 128, args.root/RUN_NAMES[arm]/'test_predictions')\n        del model, checkpoint\n    atomic_json(args.root/'test_results.json', dict(models=results, lock=lock, complete=True,\n        wall_seconds=time.monotonic()-started, references_reuse_existing_official_tests=True))\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('--stage', choices=('cpu-check', 'train', 'test'), default='train')\n    parser.add_argument('--root', type=Path, default=ROOT)\n    parser.add_argument('--resume', action='store_true')\n    parser.add_argument('--wandb', action=argparse.BooleanOptionalAction, default=True)\n    args = parser.parse_args(argv)\n    args.root, args.reference = args.root.resolve(), REFERENCE\n    args.device, args.batch_size, args.eval_batch_size = 'cuda:0', 256, 128\n    torch.set_num_threads(1)\n    args.root.mkdir(parents=True, exist_ok=True)\n    if args.stage == 'cpu-check':\n        from .r65_cpu_check import focused_check\n        result = focused_check()\n        atomic_json(args.root/'cpu_check.json', result)\n        print(json.dumps(result), flush=True)\n        return\n    baton = 'locked-test' if args.stage == 'test' else 'schedule-free-full18'\n    if (os.environ.get('R65_PARENT_GPU_BATON') != baton or os.environ.get('CUDA_VISIBLE_DEVICES') != GPU_UUID\n            or os.environ.get('SLURM_JOB_ID') != '1465' or socket.gethostname().split('.')[0] != 'gpu03'):\n        parser.error('R65 requires its explicit baton and the assigned gpu03/Slurm1465/UUID launcher')\n    configure_torch()\n    if args.stage == 'test':\n        final_test(args)\n        return\n    check = json.loads((args.root/'cpu_check.json').read_text())\n    if not check.get('passed'):\n        parser.error('The one focused CPU mode/resume check must pass before formal training')\n    (args.root/'curves').mkdir(exist_ok=True)\n    data = load_training_data(args) if (args.root/'protocol.json').exists() else prepare(args)\n    for arm in RUN_NAMES:\n        run(arm, args, data)\n        gc.collect()\n        torch.cuda.empty_cache()\n    publish_validation_candidates(args.root)\n    atomic_json(args.root/'paired_training_complete.json', dict(completed_utc=datetime.now(timezone.utc).isoformat(),\n        arms=list(RUN_NAMES), epochs_per_arm=40, updates_per_arm=9600, presentations_per_arm=7200000,\n        validation_candidates_ready=True, parent_freeze_pending=True, test_authorized=False, analysis_started=False))\n    print('[R65 paired training complete] parent validation freeze / TEST authorization pending', flush=True)\n\n\nif __name__ == '__main__':\n    main()\n\"\"\"R64 full18 paired mean-gradient/PCGrad training; TEST requires a later parent lock.\"\"\"\n\nimport argparse\nimport gc\nimport json\nimport math\nimport os\nimport random\nimport shutil\nimport socket\nimport sys\nimport threading\nimport time\nfrom collections import Counter\nfrom contextlib import redirect_stderr, redirect_stdout\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nimport numpy as np\nimport torch\n\nfrom code.unified_selector.registry import GLOBAL_SOLVERS, PROBLEMS\nfrom .multitask_probe import Tee, file_hash, gather_batch, state_hash\nfrom .pairwise_objective import inputs_only\nfrom .performance_experiment import SOURCE_FILES\nfrom .r40_experiment import aggregate, families\nfrom .r42_experiment import CostController, paired_schedule, prepare_data\nfrom .r43_experiment import policy_metrics\nfrom .r59_experiment import (GPU_UUID, REFERENCE, R43_ARGS, WORKSPACE, atomic_json,\n                             atomic_save, check_original_scope, publish_best)\nfrom .r64_gradients import GradientLayout, SHARED_PREFIXES, update_triple\nfrom .r64_model import INFERENCE_RULE, initialize\nfrom .train import configure_torch, print_eval, set_seed\nfrom .training_monitor import capture_rng, restore_rng\n\n\nROOT = WORKSPACE / 'code/V4/runs/R64_pcgrad_full18'\nRUN_NAMES = {'A': 'A_mean_gradient_seed2', 'B': 'B_pcgrad_seed2'}\nPRESENTATIONS_PER_EPOCH = 180000\nADOPTED_PLAN = WORKSPACE / 'code/V4/runs/R63_recurrent_workspaces/reviews/R63_closure_R64_plan.response.md'\nBATCH_AMENDMENT = WORKSPACE / '.aris/traces/R64_large_batch_plan.response.md'\nABORTED_ROOT = WORKSPACE / 'code/V4/runs/R64_pcgrad_full18_aborted_batch42_20261012T140928'\nTHROUGHPUT_TIE_FRACTION, REQUIRED_HEADROOM = .03, .15\nNEW_SOURCES = ('r64_model.py', 'r64_gradients.py', 'r64_experiment.py', 'r64_analysis.py',\n               'test_r64.py', 'run_v4_r64.sh', 'R64_README.md', 'r45_experiment.py',\n               'r59_experiment.py', 'r43_experiment.py', 'r42_experiment.py', 'r40_experiment.py',\n               'solver_code_encoder.py', 'pairwise_selector.py', 'pairwise_objective.py')\n\n\ndef append_jsonl(path, value):\n    with path.open('a') as stream:\n        stream.write(json.dumps(value, allow_nan=False) + '\\n')\n        stream.flush()\n\n\ndef batch_protocol(batch_size):\n    if not 1 <= batch_size <= 10000:\n        raise ValueError('Per-task batch must retain real original TRAIN rows')\n    cycles = math.ceil(10000 / batch_size)\n    tail = 10000 - batch_size * (cycles-1)\n    return dict(batch_size=batch_size, effective_batch_size=3*batch_size,\n                final_effective_batch_size=3*tail, tail_per_task=tail,\n                cycles_per_epoch=cycles, updates_per_epoch=6*cycles,\n                warmup_updates=3*6*cycles, maximum_updates_per_arm=40*6*cycles)\n\n\ndef paired_triples(sizes, epochs=40, seed=2, batch_size=256):\n    if len(sizes) != 18 or set(sizes.values()) != {10000}:\n        raise ValueError('R64 requires exactly 18 original 10000-row TRAIN tasks')\n    batch = batch_protocol(batch_size)\n    schedule = paired_schedule(sizes, epochs, batch_size=batch_size, seed=seed)\n    cycles, triples = [], []\n    for order in schedule['orders']:\n        epoch_cycles = [order[i:i+18] for i in range(0, len(order), 18)]\n        if len(epoch_cycles) != batch['cycles_per_epoch'] or any(len(c) != 18 or set(c) != set(sizes) for c in epoch_cycles):\n            raise ValueError('The existing paired schedule must really shuffle all18 once per cycle')\n        cycles.append(epoch_cycles)\n        triples.append([cycle[i:i+3] for cycle in epoch_cycles for i in range(0, 18, 3)])\n        if len(triples[-1]) != batch['updates_per_epoch']:\n            raise ValueError('R64 requires exactly six triples in each complete all18-task cycle')\n    return dict(permutations=schedule['permutations'], cycles=cycles, triples=triples,\n                **batch)\n\n\ndef triple_indices(schedule, epoch, step):\n    cycle, batch_size = step // 6, schedule['batch_size']\n    return [(task, schedule['permutations'][epoch][task][cycle*batch_size:cycle*batch_size+batch_size])\n            for task in schedule['triples'][epoch][step]]\n\n\ndef prefer_checkpoint(candidate, previous):\n    count = candidate['native_correct']\n    if type(count) is not int or not 0 <= count <= candidate['native_total']:\n        raise ValueError('Validation checkpoint selection requires integer native correct counts')\n    return previous is None or count > previous['native_correct']\n\n\ndef dropout_seed(successful):\n    return 500000003 + 2 * 100003 + successful\n\n\ndef planned_config(args):\n    batch = batch_protocol(args.batch_size)\n    return dict(seed=2, arms=RUN_NAMES, problems=list(PROBLEMS), solver_names=list(GLOBAL_SOLVERS),\n        max_epochs=40, min_epochs=15, **batch, triples_per_cycle=6,\n        presentations_per_epoch=PRESENTATIONS_PER_EPOCH,\n        maximum_presentations_per_arm=7200000, eval_batch_size=args.eval_batch_size,\n        learning_rate=1e-4, weight_decay=1e-4, adamw_betas=[.9, .999], adamw_epsilon=1e-8,\n        clip_norm=1., rdrop_weight=.35, rdrop_ramp_updates=batch['warmup_updates'],\n        dropout=.1, full_task_batch_forwards=True, dropout_passes=2,\n        loss='nativeCE mean of two independent dropout forwards + existing legal-pool symmetric KL',\n        shared_prefixes=list(SHARED_PREFIXES), projection_rng_seed=6402,\n        gradients='same-state task gradients; unscale once into FP32; selective PCGrad or arithmetic mean; one global clip and AdamW',\n        retries='whole triple; restore Python/NumPy/CPU/CUDA and independent projection RNG; reduce scale; no cursor/update advancement',\n        amp='FP16 autocast and GradScaler.scale; explicit FP32 task unscale; direct optimizer.step; explicit successful scale-growth counter',\n        dropout_stream='torch/Python/NumPy seeded by 500000003 + 2*100003 + zero-based successful update; retry restores all RNG',\n        scheduler='A controls actual LR-by-successful-update trace and epoch horizon; B replays exactly',\n        top1_min_delta_pp=.001, lr_patience=3, lr_factor=.5, stop_patience=8,\n        checkpoint_rule='strict maximum integer total native validation correct /18000; exact ties retain earliest epoch; never cost',\n        official_arm_rule='highest validation-selected integer correct count; exact tie A; parent freezes after both arms',\n        inference_rule=INFERENCE_RULE, train_eval='complete eval-mode original TRAIN every5 epochs and termination/selected checkpoint',\n        full_coverage=True, drop_last=False, no_augmentation=True, geometry_fitted_on='original TRAIN only',\n        train_prediction_saves='every5, termination, selected checkpoint', val_prediction_saves='every epoch and selected checkpoint',\n        checkpoint_every_successful_updates=60, inference_timing='once during final selected validation; first16/task singleton, remainder batched',\n        wandb=dict(project='selector', entity='yjkds-southern-university-of-science-technology', mode='offline'),\n        adopted_plan=str(ADOPTED_PLAN.relative_to(WORKSPACE)), adopted_plan_sha256=file_hash(ADOPTED_PLAN),\n        adopted_batch_amendment=str(BATCH_AMENDMENT.relative_to(WORKSPACE)),\n        adopted_batch_amendment_sha256=file_hash(BATCH_AMENDMENT),\n        batch_decision_sha256=file_hash(args.root/'large_batch_decision.json'),\n        planner_boundary='Astra/max text/context planning; no direct local-code audit or GPU execution',\n        aborted_batch42_archive=str(ABORTED_ROOT), fresh_restart_both_arms=True,\n        authorized_train_only_batch_sizing=True, learning_rate_scaled_with_batch=False,\n        optimizer_update_budget_reduced_from_aborted_57360=True,\n        legacy_B_semantics='unresolved and preserved; R58 deferred', target_native_macro_top1=.70,\n        test_read=False, gpu_preflight=False, automatic_analysis=False)\n\n\ndef source_hashes():\n    paths = [Path(__file__).parent / n for n in sorted(set(SOURCE_FILES + NEW_SOURCES))]\n    paths += [WORKSPACE / 'code/unified_selector' / n for n in ('registry.py', 'data.py')]\n    return {str(p.relative_to(WORKSPACE)): file_hash(p) for p in paths}\n\n\ndef load_inputs(args):\n    loaders, raw, geometry = prepare_data(args)\n    check_original_scope(loaders, raw)\n    if len(GLOBAL_SOLVERS) != 22 or sum(len(r['pool_ids']) for r in raw['train'].values()) != 128:\n        raise ValueError('R64 must retain all22 identities and all128 original legal deployments')\n    return loaders, raw, geometry\n\n\ndef prepare(args, inputs=None):\n    protocol = planned_config(args)\n    protocol.update(source_hashes=source_hashes(), r43_args_sha256=file_hash(R43_ARGS))\n    for relative, digest in protocol['source_hashes'].items():\n        destination = args.root / 'source_launch' / relative\n        destination.parent.mkdir(parents=True, exist_ok=True)\n        if destination.exists() and file_hash(destination) != digest:\n            raise ValueError('Preserve the existing R64 launch snapshot: ' + str(destination))\n        if not destination.exists():\n            shutil.copy2(WORKSPACE / relative, destination)\n    atomic_json(args.root / 'source_launch/hashes.json', protocol['source_hashes'])\n    loaders, raw, geometry = load_inputs(args) if inputs is None else inputs\n    sizes = {p: l.size for p, l in loaders['train'].items()}\n    schedule = paired_triples(sizes, batch_size=args.batch_size)\n    atomic_save(args.root / 'schedule_seed2.pt', schedule)\n    model, params = initialize(geometry, args.device)\n    initial = {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}\n    layout = GradientLayout(model)\n    atomic_save(args.root / 'selector_initial.pt', initial)\n    protocol.update(initial_model_hash=state_hash(initial), model_params=params, sizes=sizes,\n        trainable_parameters=sum(p.numel() for p in model.parameters()),\n        gradient_layout=layout.receipt, geometry_stats=geometry, schedule_hash=state_hash(schedule),\n        data_manifest=json.loads((args.root / 'data_manifest.json').read_text()))\n    atomic_json(args.root / 'initialization.json', dict(seed=2, fresh=True, shared_state_sha256=protocol['initial_model_hash'],\n        no_historical_weights=True, projected_parameters=layout.receipt))\n    atomic_json(args.root / 'protocol.json', protocol)\n    del model, layout\n    batch = batch_protocol(args.batch_size)\n    plan = ('# R64 adopted larger real-batch restart\\n\\n'\n            f'Both arms restart fresh at seed2. Old run is aborted and immutable: `{ABORTED_ROOT}`.\\n'\n            f'Adopted amendment: `{BATCH_AMENDMENT}`; verbatim response stored alongside this plan.\\n'\n            'Astra/max supplied text/context planning, not a direct local-code audit.\\n\\n'\n            f'Locked per-task batch {args.batch_size}, effective batch {batch[\"effective_batch_size\"]}; '\n            f'{batch[\"cycles_per_epoch\"]} all18-task cycles, six triples each, '\n            f'{batch[\"updates_per_epoch\"]} updates/epoch. Final task tail {batch[\"tail_per_task\"]}, '\n            f'final effective batch {batch[\"final_effective_batch_size\"]}. All180000 rows/epoch retained.\\n'\n            f'Warmup/R-Drop ramp {batch[\"warmup_updates\"]} successful updates (three epochs). '\n            f'Max40 epochs/{batch[\"maximum_updates_per_arm\"]} updates/7.2M presentations per arm. '\n            'The reduced optimizer-update budget is part of this amendment.\\n\\n'\n            'Unchanged LR1e-4, AdamW WD1e-4/betas(.9,.999)/eps1e-8, global clip1, nativeCE + '\n            '.35 symmetric R-Drop; no microbatching/accumulation or automatic LR scaling. '\n            'Same R45A architecture, original full18/fullpools/native winners and directed ATSP inputs. '\n            'A averages; B alone projects the adopted shared dense prefixes. A controls actual LR/horizon; '\n            'B replays exactly. Integer validation correct counts choose best; exact ties earlier, official arm tieA.\\n\\n'\n            'Selection used only the predeclared bounded TRAIN capacity/throughput pass, '\n            'two warmup plus three timed complete updates per arm/size, at most three sizes. '\n            'Eligibility requires at least15% physical memory headroom; highest PCGrad throughput '\n            'with3% timing ties toward smaller batch. All calibration states/updates are discarded and costed separately.\\n\\n'\n            'Full validation every epoch; eval-mode full TRAIN every5 and termination/selected checkpoint. '\n            'No automatic TEST/analysis/git/review gate. Parent freezes both completed validation-selected models, '\n            'inference and official arm before authorizing one full TEST/model; existing R45A/R60B tests reused. '\n            'R58 and unresolved legacy B semantics remain deferred; single-solver70% goal active.\\n')\n    (args.root/'PLAN.md').write_text(plan)\n    atomic_json(args.root/'planned_configs.json', protocol)\n    print('[R64 prepared] locked batch ' + json.dumps(batch) + '; next update is fresh FORMAL', flush=True)\n    return protocol, loaders, raw, geometry, schedule\n\n\ndef load_training_data(args):\n    protocol = json.loads((args.root / 'protocol.json').read_text())\n    if (protocol['source_hashes'] != source_hashes() or protocol['r43_args_sha256'] != file_hash(R43_ARGS)\n            or protocol['eval_batch_size'] != args.eval_batch_size\n            or protocol['batch_size'] != args.batch_size\n            or protocol['adopted_plan_sha256'] != file_hash(ADOPTED_PLAN)\n            or protocol['adopted_batch_amendment_sha256'] != file_hash(BATCH_AMENDMENT)\n            or protocol['batch_decision_sha256'] != file_hash(args.root/'large_batch_decision.json')):\n        raise ValueError('R64 frozen source/configuration changed after preparation')\n    loaders, raw, geometry = load_inputs(args)\n    if (geometry != protocol['geometry_stats']\n            or json.loads((args.root / 'data_manifest.json').read_text()) != protocol['data_manifest']):\n        raise ValueError('R64 original data or TRAIN-fitted geometry changed')\n    schedule = torch.load(args.root / 'schedule_seed2.pt', map_location='cpu', weights_only=False)\n    if state_hash(schedule) != protocol['schedule_hash']:\n        raise ValueError('R64 shared paired batches changed')\n    return protocol, loaders, raw, geometry, schedule\n\n\ndef synchronize(device):\n    if str(device).startswith('cuda'):\n        torch.cuda.synchronize(device)\n\n\n@torch.no_grad()\ndef evaluate(model, loaders, raw, batch_size=128, prediction_dir=None, timing_path=None):\n    was_training, results, timings = model.training, {}, {}\n    model.eval()\n    started = time.monotonic()\n    if prediction_dir is not None:\n        prediction_dir.mkdir(parents=True, exist_ok=True)\n    try:\n        for problem, loader in loaders.items():\n            device, scores, measured = loader.batch['ind'].device, [], []\n            singleton = min(16, loader.size) if timing_path is not None else 0\n            groups = [torch.tensor([i]) for i in range(singleton)]\n            groups += [torch.arange(i, min(i+batch_size, loader.size))\n                       for i in range(singleton, loader.size, batch_size)]\n            for indices in groups:\n                synchronize(device)\n                before = time.monotonic()\n                batch = inputs_only(gather_batch(loader, indices))\n                output = model(batch)['logits'].float().cpu()\n                scores.append(output)\n                if timing_path is not None:\n                    synchronize(device)\n                    measured.append(dict(queries=len(indices), seconds=time.monotonic()-before,\n                                         indices=indices.tolist(), true_sizes=loader.lengths[indices].tolist()))\n            scores = torch.cat(scores).numpy()\n            if len(scores) != loader.size:\n                raise ValueError('R64 evaluation must retain every original row and tail')\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"source /public/home/shiys/miniconda3/etc/profile.d/conda.sh\nconda activate easynco\ncat code/V4/r65_cpu_check.py\nsed -n '1,270p' code/V4/r66_cpu_check.py\nsed -n '1,260p' code/V4/dual_stream.py\ncat code/V4/r65_official_schedulefree/provenance.json\"","aggregated_output":"\"\"\"One focused CPU check: official optimizer modes/resume and actual selected batches.\"\"\"\n\nimport io\nfrom types import SimpleNamespace\n\nimport torch\n\nfrom code.unified_selector.registry import PROBLEMS\nfrom .multitask_probe import state_hash\nfrom .r64_experiment import paired_triples\nfrom .r65_gradients import GradientLayout, update_triple\nfrom .r65_optimizer import (configure_update_lr, evaluation_mode, make_optimizer,\n                            observed_lr, training_mode)\n\n\ndef focused_check():\n    from .r65_experiment import select_triple_batches\n\n    torch.manual_seed(2)\n    model = torch.nn.Linear(3, 2)\n    optimizer = make_optimizer(model, 'B')\n    inputs = torch.tensor([[1., -.3, .7], [-.2, .8, .4]])\n    target = torch.tensor([[.3, -.1], [.8, .2]])\n\n    def advance(current_model, current_optimizer, successful):\n        training_mode(current_model, current_optimizer, 'B')\n        expected = configure_update_lr(current_optimizer, 'B', successful)\n        current_optimizer.zero_grad(set_to_none=True)\n        (current_model(inputs)-target).square().mean().backward()\n        current_optimizer.step()\n        return observed_lr(current_optimizer, 'B', expected)\n\n    lrs = [advance(model, optimizer, successful) for successful in range(6)]\n    y = {key: value.detach().clone() for key, value in model.state_dict().items()}\n    evaluation_mode(model, optimizer, 'B')\n    x = {key: value.detach().clone() for key, value in model.state_dict().items()}\n    assert any(not torch.equal(x[key], y[key]) for key in x), 'Expected distinct x and y after updates'\n    assert all(not group['train_mode'] for group in optimizer.param_groups)\n    stream = io.BytesIO()\n    torch.save(dict(model=model.state_dict(), optimizer=optimizer.state_dict(), successful_updates=6,\n                    checkpoint_mode='eval'), stream)\n    evaluation_mode(model, optimizer, 'B')\n    for key, value in model.state_dict().items():\n        torch.testing.assert_close(value, x[key], rtol=0, atol=0)\n    training_mode(model, optimizer, 'B')\n    roundtrip_error = max(float((value-y[key]).abs().max()) for key, value in model.state_dict().items())\n    for key, value in model.state_dict().items():\n        torch.testing.assert_close(value, y[key], rtol=0, atol=2e-7)\n    training_mode(model, optimizer, 'B')\n    for key, value in model.state_dict().items():\n        torch.testing.assert_close(value, y[key], rtol=0, atol=2e-7)\n    stream.seek(0)\n    checkpoint = torch.load(stream, map_location='cpu', weights_only=False)\n    resumed = torch.nn.Linear(3, 2)\n    resumed_optimizer = make_optimizer(resumed, 'B')\n    resumed.load_state_dict(checkpoint['model'])\n    resumed_optimizer.load_state_dict(checkpoint['optimizer'])\n    assert all(not group['train_mode'] for group in resumed_optimizer.param_groups)\n    assert checkpoint['checkpoint_mode'] == 'eval'\n    for successful in range(6, 9):\n        assert advance(model, optimizer, successful) == advance(resumed, resumed_optimizer, successful)\n    evaluation_mode(model, optimizer, 'B')\n    evaluation_mode(resumed, resumed_optimizer, 'B')\n    for key, value in model.state_dict().items():\n        torch.testing.assert_close(value, resumed.state_dict()[key], rtol=0, atol=0)\n    assert state_hash(optimizer.state_dict()) == state_hash(resumed_optimizer.state_dict())\n\n    schedule = paired_triples({task: 10000 for task in PROBLEMS}, epochs=1, seed=2, batch_size=256)\n    loaders = {}\n    indices = torch.arange(10000)\n    for problem_id, task in enumerate(PROBLEMS):\n        loaders[task] = SimpleNamespace(lengths=torch.ones(10000, dtype=torch.long), batch=dict(\n            problem_id=problem_id, row_index=indices, costs=torch.zeros(10000, 3),\n            ind=indices % 3, input=(indices.float()/10000).unsqueeze(1)))\n    entries, batches = select_triple_batches(loaders, schedule, 0, 0)\n\n    class ObservedRows(torch.nn.Module):\n        def __init__(self):\n            super().__init__()\n            self.linear = torch.nn.Linear(1, 3)\n            self.seen = []\n\n        def forward(self, batch):\n            self.seen.append((batch['problem_id'], batch['row_index'].clone(), batch['input'].data_ptr()))\n            logits = self.linear(batch['input'])\n            return dict(logits=logits, solver_mask=torch.ones_like(logits, dtype=torch.bool))\n\n    observed = ObservedRows()\n    plain = make_optimizer(observed, 'A')\n    configure_update_lr(plain, 'A', 0)\n    values = update_triple(observed, plain, torch.amp.GradScaler('cuda', enabled=False), batches,\n                           .35/720, GradientLayout(observed))\n    assert len(observed.seen) == 6 and values['finite_gradient']\n    for offset, ((task, selected), batch) in enumerate(zip(entries, batches)):\n        assert len(selected) == len(batch['ind']) == 256\n        torch.testing.assert_close(batch['row_index'], selected, rtol=0, atol=0)\n        for problem_id, actual, pointer in observed.seen[2*offset:2*offset+2]:\n            assert problem_id == batch['problem_id'] and pointer == batch['input'].data_ptr()\n            torch.testing.assert_close(actual, selected, rtol=0, atol=0)\n    tail_entries, tail_batches = select_triple_batches(loaders, schedule, 0, 239)\n    assert [len(batch['ind']) for batch in tail_batches] == [16, 16, 16]\n    for (_, selected), batch in zip(tail_entries, tail_batches):\n        torch.testing.assert_close(batch['row_index'], selected, rtol=0, atol=0)\n    return dict(passed=True, focused_cpu_checks=1, optimizer='official AdamWScheduleFree',\n        eval_train_roundtrip=True, roundtrip_max_abs_error=roundtrip_error,\n        checkpoint_mode='eval x plus optimizer train_mode=False', exact_resume_model_and_optimizer=True,\n        resumed_successful_updates=9, no_double_warmup=True, first_effective_lr=lrs[0],\n        actual_selected_rows_forwarded=True, real_task_rows=[256, 256, 256],\n        tail_task_rows=[16, 16, 16], actual_two_forwards_share_selected_batch=True,\n        fp32_arithmetic_mean=True, gpu_used=False, data_or_test_loaded=False)\n\"\"\"One focused CPU check of R66's offset, initialization, boundary and modes.\"\"\"\n\nimport copy\nimport io\n\nimport torch\n\nfrom code.unified_selector.registry import K_CBITS, K_PROBLEM_DESC\nfrom .multitask_probe import state_hash\nfrom .r65_gradients import GradientLayout, update_triple\nfrom .r65_optimizer import (configure_update_lr, evaluation_mode, make_optimizer,\n                            observed_lr, training_mode)\nfrom .r66_model import (BASE_SHA256, CACHE_INPUT, INPUT_KEYS, build_selector,\n                        load_base_caches, load_base_checkpoint, shared_initialization)\nfrom .r66_objective import objective\n\n\ndef focused_check():\n    checkpoint = load_base_checkpoint()\n    params, geometry = checkpoint['args']['model_params'], checkpoint['args']['geometry_stats']\n    initial, initialization = shared_initialization(params, geometry)\n    caches, cache_receipt = load_base_caches()\n    del caches\n    base = torch.tensor([[1.7, -.8, .2], [-.5, .4, 1.1]], requires_grad=True)\n    mask, winner = torch.ones(2, 3, dtype=torch.bool), torch.tensor([0, 1])\n    gradients, losses = {}, {}\n    for arm in ('A', 'B'):\n        first = torch.tensor([[.2, -.1, .3], [.1, .2, -.2]], requires_grad=True)\n        second = (first.detach()+torch.tensor([[.1, .2, -.1], [-.1, .1, .2]])).requires_grad_()\n        loss, parts = objective(dict(logits=first, solver_mask=mask),\n            dict(logits=second, solver_mask=mask), base, winner, .35, arm)\n        loss.backward()\n        assert first.grad is not None and second.grad is not None and base.grad is None\n        gradients[arm], losses[arm] = first.grad.clone(), float(loss.detach())\n        offset = 0. if arm == 'A' else base.detach()\n        expected = .5*(torch.nn.functional.cross_entropy(first+offset, winner)\n                       +torch.nn.functional.cross_entropy(second+offset, winner))\n        torch.testing.assert_close(parts['ce'], expected, rtol=0, atol=0)\n    assert not torch.equal(gradients['A'], gradients['B'])\n    model = build_selector(params, checkpoint['model'], initial, 'B', cached=True)\n    base_hash = state_hash(model.base.state_dict())\n    optimizer = make_optimizer(model.member, 'B')\n    assert {id(p) for group in optimizer.param_groups for p in group['params']} == {\n        id(p) for p in model.member.parameters()}\n    seen = []\n\n    def boundary(module, args):\n        assert set(args[0]) <= INPUT_KEYS\n        seen.append('base' if module is model.base else 'member')\n\n    hooks = [module.register_forward_pre_hook(boundary) for module in (model.base, model.member)]\n    fixture = dict(problem_id=0, kind='coord', node=torch.rand(2, 8, 8),\n        node_mask=torch.ones(2, 8, dtype=torch.bool), n=torch.full((2,), 8),\n        cbits=torch.zeros(2, K_CBITS), problem_desc=torch.zeros(2, K_PROBLEM_DESC),\n        coord_dist=torch.zeros(2, dtype=torch.long), pool_ids=torch.tensor([0, 1, 3]),\n        node_geom=torch.zeros(2, 8, len(geometry['mean'])),\n        ind=winner, costs=torch.full((2, 3), float('nan')), winner='forbidden',\n        routes='forbidden', pred='forbidden', **{CACHE_INPUT: base.detach()})\n    training_mode(model, optimizer, 'B')\n    assert not model.base.training and all(not p.requires_grad for p in model.base.parameters())\n    assert all(not module.training for module in model.base.modules())\n    output = model(fixture)\n    torch.testing.assert_close(output['logits'], base.detach(), rtol=0, atol=0)\n    torch.nn.functional.cross_entropy(output['logits'], winner).backward()\n    assert not model.member.instance_encoder.coord_proj.weight.grad.count_nonzero()\n    assert model.member.score_head[-1].weight.grad.norm() > 0\n    optimizer.zero_grad(set_to_none=True)\n    triples = [dict(fixture, problem_id=task) for task in range(3)]\n    expected = configure_update_lr(optimizer, 'B', 0)\n    values = update_triple(model, optimizer, torch.amp.GradScaler('cuda', enabled=False),\n                           triples, .35/720, GradientLayout(model))\n    lr = observed_lr(optimizer, 'B', expected)\n    assert values['finite_loss'] and values['finite_gradient']\n    for successful in range(1, 3):\n        configure_update_lr(optimizer, 'B', successful)\n        update_triple(model, optimizer, torch.amp.GradScaler('cuda', enabled=False),\n                      triples, .35*(successful+1)/720, GradientLayout(model))\n    y = {key: value.detach().clone() for key, value in model.member.state_dict().items()}\n    evaluation_mode(model, optimizer, 'B')\n    x = {key: value.detach().clone() for key, value in model.member.state_dict().items()}\n    assert any(not torch.equal(x[key], y[key]) for key in x)\n    assert all(not group['train_mode'] for group in optimizer.param_groups)\n    stream = io.BytesIO()\n    torch.save(dict(model=model.state_dict(), optimizer=optimizer.state_dict()), stream)\n    stream.seek(0)\n    saved = torch.load(stream, map_location='cpu', weights_only=False)\n    resumed = build_selector(params, checkpoint['model'], initial, 'B', cached=True)\n    resumed_optimizer = make_optimizer(resumed.member, 'B')\n    resumed.load_state_dict(saved['model'])\n    resumed_optimizer.load_state_dict(saved['optimizer'])\n    training_mode(model, optimizer, 'B')\n    training_mode(resumed, resumed_optimizer, 'B')\n    for successful in (3,):\n        for current, opt in ((model, optimizer), (resumed, resumed_optimizer)):\n            torch.manual_seed(660100+successful)\n            configure_update_lr(opt, 'B', successful)\n            update_triple(current, opt, torch.amp.GradScaler('cuda', enabled=False),\n                          triples, .35*(successful+1)/720, GradientLayout(current))\n            evaluation_mode(current, opt, 'B')\n    assert state_hash(model.state_dict()) == state_hash(resumed.state_dict())\n    assert state_hash(optimizer.state_dict()) == state_hash(resumed_optimizer.state_dict())\n    seen.clear()\n    deployed = model.deployment_forward(fixture)\n    assert seen == ['base', 'member']\n    clean = {key: value for key, value in fixture.items() if key in INPUT_KEYS}\n    with torch.no_grad():\n        expected_logits = model.base(clean)['logits']+model.member(clean)['logits']\n    torch.testing.assert_close(deployed['logits'], expected_logits, rtol=0, atol=0)\n    independent = copy.deepcopy(model)\n    independent.arm = 'A'\n    torch.testing.assert_close(independent.deployment_forward(fixture)['logits'], deployed['logits'], rtol=0, atol=0)\n    independent.train()\n    assert not independent.base.training\n    assert state_hash(model.base.state_dict()) == base_hash\n    assert all(p.grad is None and not p.requires_grad for p in model.base.parameters())\n    for hook in hooks:\n        hook.remove()\n    return (dict(passed=True, focused_cpu_checks=1, gpu_used=False, synthetic_fixtures_only=True,\n        real_train_val_cache_alignment=True, cache_fields_only=['logits', 'indices', 'pool_ids', 'pool'],\n        original_indices_names_and_pool_ids=True, base_sha256=BASE_SHA256,\n        offset_objectives_and_both_branches=True, objective_fixture_losses=losses,\n        identical_explicit_copied_initialization=True, zero_scalar_head=True,\n        expected_initial_zero_encoder_gradient=True, frozen_base_no_grad_eval=True,\n        no_label_cost_winner_route_forward_inputs=True, composite_live_deployment_both_arms=True,\n        optimizer_only_member=True, optimizer='exact official R65B AdamWScheduleFree',\n        y_train_x_eval_save=True, exact_resume_model_and_optimizer=True,\n        reused_whole_triple_update_finite=True, first_effective_lr=lr,\n        no_external_warmup=True, test_read=False),\n        checkpoint, initial, initialization, cache_receipt)\n\"\"\"Instance/solver co-encoding with synchronous bidirectional cross-attention.\"\"\"\n\nimport torch\nfrom torch import nn\n\nfrom code.unified_selector.registry import M_GLOBAL\nfrom .solver_features import SOLVER_FEATURE_DIM, build_solver_features\nfrom .V4Model import InstanceEncoder, MultiHeadAttention, FeedForward, _masked_mean, _masked_max\n\n\nclass SolverFeatureEncoder(nn.Module):\n    def __init__(self, **params):\n        super().__init__()\n        d = params[\"embedding_dim\"]\n        self.register_buffer(\"solver_features\", build_solver_features(params[\"solver_feature_spec\"]))\n        self.solver_emb = nn.Embedding(M_GLOBAL, d)\n        self.feature_mlp = nn.Sequential(\n            nn.Linear(SOLVER_FEATURE_DIM, params[\"solver_feature_hidden\"]),\n            nn.GELU(),\n            nn.Dropout(params[\"dropout\"]),\n            nn.Linear(params[\"solver_feature_hidden\"], d),\n        )\n        self.weight = params.get(\"solver_feature_weight\", 1.0)\n        self.norm = nn.LayerNorm(d)\n\n    def forward(self, solver_ids):\n        features = self.feature_mlp(self.solver_features[solver_ids])\n        return self.norm(self.solver_emb(solver_ids) + self.weight * features)\n\n\nclass CrossUpdate(nn.Module):\n    def __init__(self, **params):\n        super().__init__()\n        d = params[\"embedding_dim\"]\n        self.attn = MultiHeadAttention(d, params[\"head_num\"], params[\"qkv_dim\"], params[\"dropout\"], params.get(\"sdpa\", False))\n        self.ffn = FeedForward(d, params[\"ff_hidden_dim\"], params[\"dropout\"])\n        self.norm1 = nn.LayerNorm(d)\n        self.norm2 = nn.LayerNorm(d)\n        self.dropout = nn.Dropout(params[\"dropout\"])\n\n    def forward(self, query, memory, query_mask, memory_mask):\n        x = self.norm1(query + self.dropout(self.attn(query, memory, memory, key_mask=memory_mask)))\n        x = self.norm2(x + self.dropout(self.ffn(x)))\n        return x.masked_fill(~query_mask.unsqueeze(-1), 0.0)\n\n\nclass JointEncoderLayer(nn.Module):\n    def __init__(self, **params):\n        super().__init__()\n        self.node_update = CrossUpdate(**params)\n        self.solver_update = CrossUpdate(**params)\n\n    def forward(self, nodes, solvers, node_mask, solver_mask):\n        # Both directions read the previous layer, not the other direction's update.\n        next_nodes = self.node_update(nodes, solvers, node_mask, solver_mask)\n        next_solvers = self.solver_update(solvers, nodes, solver_mask, node_mask)\n        return next_nodes, next_solvers\n\n\nclass DualStreamSelector(nn.Module):\n    def __init__(self, **params):\n        super().__init__()\n        self.params = params\n        d = params[\"embedding_dim\"]\n        self.instance_encoder = InstanceEncoder(**dict(params, node_only=True))\n        self.solver_encoder = SolverFeatureEncoder(**params)\n        self.joint_layers = nn.ModuleList([JointEncoderLayer(**params) for _ in range(params.get(\"joint_layer_num\", 2))])\n        self.pool = nn.Sequential(nn.Linear(2 * d, d), nn.GELU(), nn.Linear(d, d))\n        self.decoder = MultiHeadAttention(d, params[\"head_num\"], params[\"qkv_dim\"], params[\"dropout\"], params.get(\"sdpa\", False))\n        self.score_head = nn.Sequential(\n            nn.Linear(3 * d, params[\"head_hidden_dim\"]), nn.GELU(),\n            nn.Dropout(params[\"dropout\"]), nn.Linear(params[\"head_hidden_dim\"], 1),\n        )\n\n    def adapt_nodes(self, nodes, node_mask, batch):\n        return nodes\n\n    def encode_state(self, batch):\n        nodes, node_mask = self.instance_encoder(batch)\n        nodes = self.adapt_nodes(nodes, node_mask, batch)\n        ids = batch[\"pool_ids\"].to(nodes.device)\n        if ids.dim() == 1:\n            ids = ids.unsqueeze(0).expand(nodes.size(0), -1)\n        solver_mask = batch.get(\"solver_mask\")\n        if solver_mask is None:\n            solver_mask = torch.ones_like(ids, dtype=torch.bool)\n        else:\n            solver_mask = solver_mask.to(device=nodes.device, dtype=torch.bool)\n            if solver_mask.shape != ids.shape or not solver_mask.any(dim=1).all():\n                raise ValueError(\"solver_mask must match pool_ids and retain at least one solver per instance\")\n        ids = ids.masked_fill(~solver_mask, 0)\n        solvers = self.solver_encoder(ids).masked_fill(~solver_mask.unsqueeze(-1), 0.0)\n        for layer in self.joint_layers:\n            nodes, solvers = layer(nodes, solvers, node_mask, solver_mask)\n        h = self.pool(torch.cat([_masked_mean(nodes, node_mask), _masked_max(nodes, node_mask)], dim=-1))\n        return nodes, solvers, h, node_mask, solver_mask\n\n    def encode_pairs(self, batch):\n        nodes, solvers, h, node_mask, solver_mask = self.encode_state(batch)\n        context = self.decoder(h[:, None, :], solvers, solvers, key_mask=solver_mask)\n        features = torch.cat([h[:, None, :].expand_as(solvers), context.expand_as(solvers), solvers], dim=-1)\n        return features, solver_mask\n\n    def forward(self, batch):\n        features, solver_mask = self.encode_pairs(batch)\n        logits = self.score_head(features).squeeze(-1).masked_fill(~solver_mask, float(\"-inf\"))\n        return {\"logits\": logits}\n\n\nclass PerformanceSelector(DualStreamSelector):\n    \"\"\"R39: independent winner classification and centered performance estimates.\"\"\"\n\n    def __init__(self, **params):\n        super().__init__(**params)\n        from code.unified_selector.registry import PROBLEMS\n        self.register_buffer(\"performance_scales\", torch.ones(len(PROBLEMS), dtype=torch.float64))\n        d, hidden = params[\"embedding_dim\"], params[\"head_hidden_dim\"]\n        self.performance_head = nn.Sequential(\n            nn.Linear(3 * d, hidden), nn.GELU(),\n            nn.Dropout(params[\"dropout\"]), nn.Linear(hidden, 1),\n        )\n        self.decision_head = params.get(\"decision_head\", \"performance\")\n        if self.decision_head not in (\"classification\", \"performance\"):\n            raise ValueError(\"decision_head must be classification or performance\")\n\n    def forward(self, batch):\n        from .performance_targets import center_valid\n        features, mask = self.encode_pairs(batch)\n        logits = self.score_head(features).squeeze(-1).masked_fill(~mask, float(\"-inf\"))\n        prediction = center_valid(self.performance_head(features).squeeze(-1).float(), mask)\n        prediction = prediction.masked_fill(~mask, float(\"inf\"))\n        selection = logits if self.decision_head == \"classification\" else -prediction\n        return dict(logits=logits, pred_performance=prediction, solver_mask=mask, selection_scores=selection)\n{\n  \"upstream\": \"https://github.com/facebookresearch/schedule_free\",\n  \"commit\": \"70785b53e778d0e872c0bbb75ff4ee54ee10c291\",\n  \"source\": \"schedulefree/adamw_schedulefree.py\",\n  \"source_url\": \"https://raw.githubusercontent.com/facebookresearch/schedule_free/70785b53e778d0e872c0bbb75ff4ee54ee10c291/schedulefree/adamw_schedulefree.py\",\n  \"license\": \"Apache-2.0\",\n  \"license_url\": \"https://raw.githubusercontent.com/facebookresearch/schedule_free/70785b53e778d0e872c0bbb75ff4ee54ee10c291/LICENSE\",\n  \"modifications\": \"none; source and license copied verbatim\",\n  \"environment_changed\": false\n}\n","exit_code":0,"status":"completed"}}
